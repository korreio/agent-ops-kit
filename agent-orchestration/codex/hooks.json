{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$HOME/.codex/hooks/shared-guard.sh\" brew-guards"
          },
          {
            "type": "command",
            "command": "/bin/bash \"$HOME/.codex/hooks/shared-guard.sh\" secrets-guard"
          },
          {
            "type": "command",
            "command": "/bin/bash \"$HOME/.codex/hooks/shared-guard.sh\" git-staging-guard"
          },
          {
            "type": "command",
            "command": "/bin/bash \"$HOME/.codex/hooks/worker-git.sh\""
          },
          {
            "type": "command",
            "command": "/bin/bash \"$HOME/.codex/hooks/shared-guard.sh\" outward-ask"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$HOME/.codex/hooks/bash-syntax.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$HOME/.codex/hooks/roster-freshness.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
